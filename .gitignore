# dependencies
node_modules/

# build & cache output
dist/
.astro/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & IDE
.DS_Store
.vscode/
.idea/

# Large media files
# Audiobook audio is deployed out of band (rsync/deploy.sh), not committed:
# the full-book MP3 alone is ~240 MB, above GitHub's per-file limit.
*.mp3
*.m4b
public/audio/*.mp3

# Audiobook build workspace (cache, scripts, uncompressed masters)
audiobook-build/

# Voice reference recordings (large, personal)
voices/*.wav

# python
__pycache__/
*.pyc
