---
import BookLayout from '../layouts/BookLayout.astro';
import { listBooks, getBookSlug } from '../lib/books';
import { getUrl } from '../lib/utils';

const books = await listBooks();
---

<BookLayout title="BookForge — A Book Press">
  <div class="bookshelf-page">
    <section class="bookshelf-hero">
      <div class="section-label">THE BOOK PRESS</div>
      <h1 class="shelf-title">Meistro's Library</h1>
      <p class="shelf-subtitle">
        BookForge is a calm room built to hold manuscripts. Drop a book folder in and it appears on the shelf.
      </p>
    </section>

    {books.length > 0 ? (
      <section class="bookshelf-grid">
        {books.map((book) => {
          const slug = getBookSlug(book);
          const cover = book.data.cover || 'images/book_cover.jpg';
          return (
            <a href={getUrl('/books/' + slug + '/')} class="book-card-link">
              <article class="book-card">
                <div class="book-cover-wrap">
                  <img
                    src={getUrl(cover)}
                    alt={'Cover for ' + book.data.title}
                    class="book-cover"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="book-meta">
                  <h2 class="book-title">{book.data.title}</h2>
                  {book.data.subtitle && <p class="book-subtitle">{book.data.subtitle}</p>}
                  <p class="book-author">{book.data.author}</p>
                </div>
              </article>
            </a>
          );
        })}
      </section>
    ) : (
      <section class="empty-state">
        <div class="empty-icon">📚</div>
        <h2 class="empty-title">The shelf is empty</h2>
        <p class="empty-desc">
          Add a book folder under <code>src/content/books/&lt;slug&gt;/</code> with a
          <code>book.json</code> and a <code>chapters/</code> directory, and it will show up here.
        </p>
      </section>
    )}
  </div>
</BookLayout>

<style>
  .bookshelf-page { max-width: 1080px; margin: 0 auto; padding: 3rem 1.5rem 6rem; width: 100%; }
  .bookshelf-hero { padding-bottom: 2.5rem; margin-bottom: 3rem; border-bottom: 1px solid var(--border-color); }
  .section-label { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em; color: var(--accent-color); margin-bottom: 0.75rem; }
  .shelf-title { font-size: 2.75rem; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary); margin-bottom: 0.75rem; }
  .shelf-subtitle { font-size: 1.15rem; color: var(--text-secondary); line-height: 1.5; max-width: 640px; }

  .bookshelf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 2rem; }
  .book-card-link { text-decoration: none; display: block; }
  .book-card { display: flex; flex-direction: column; gap: 1rem; background-color: var(--panel-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.5rem; height: 100%; transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease; }
  .book-card-link:hover .book-card { transform: translateY(-4px); border-color: var(--accent-color); box-shadow: 0 12px 28px rgba(0, 0, 0, 0.1); }
  .book-card-link:focus-visible .book-card { outline: 2px solid var(--accent-color); outline-offset: 2px; }
  .book-cover-wrap { display: flex; justify-content: center; }
  .book-cover { width: 100%; max-width: 200px; height: auto; border-radius: 6px; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12); border: 1px solid var(--border-color); }
  .book-meta { text-align: center; }
  .book-title { font-size: 1.15rem; font-weight: 800; line-height: 1.3; color: var(--text-primary); margin-bottom: 0.3rem; }
  .book-subtitle { font-size: 0.875rem; font-style: italic; color: var(--text-secondary); margin-bottom: 0.3rem; }
  .book-author { font-size: 0.9rem; color: var(--text-secondary); }

  .empty-state { background-color: var(--panel-bg); border: 1px dashed var(--border-color); border-radius: 12px; padding: 4rem 2rem; text-align: center; }
  .empty-icon { font-size: 3rem; margin-bottom: 1rem; }
  .empty-title { font-size: 1.75rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.75rem; }
  .empty-desc { font-size: 1rem; color: var(--text-secondary); line-height: 1.6; max-width: 520px; margin: 0 auto; }
  .empty-desc code { background-color: rgba(2, 132, 199, 0.08); color: var(--accent-color); padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.85em; }

  @media (max-width: 640px) {
    .shelf-title { font-size: 2.1rem; }
    .bookshelf-page { padding: 1.75rem 1rem 4rem; }
  }
</style>
