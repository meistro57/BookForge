---
import type { ChapterEntry } from '../lib/chapters';
import { getChapterSlug, getUrl } from '../lib/chapters';

interface Props {
  prevChapter?: ChapterEntry;
  nextChapter?: ChapterEntry;
  contentsLink?: string;
}

const { prevChapter, nextChapter, contentsLink = getUrl('/') } = Astro.props;
---

<nav class="chapter-nav" aria-label="Chapter Navigation">
  <div class="nav-item nav-prev">
    {prevChapter ? (
      <a href={getUrl(`/chapter/${getChapterSlug(prevChapter)}/`)} class="nav-link" rel="prev">
        <span class="nav-label">← Previous</span>
        <span class="nav-title">{prevChapter.data.title}</span>
      </a>
    ) : (
      <span class="nav-disabled">
        <span class="nav-label">← Previous</span>
        <span class="nav-title">Beginning of manuscript</span>
      </span>
    )}
  </div>

  <div class="nav-item nav-contents">
    <a href={contentsLink} class="nav-link contents-link" aria-label="Return to Table of Contents">
      <span class="nav-icon">☰</span>
      <span class="nav-label">Contents</span>
    </a>
  </div>

  <div class="nav-item nav-next">
    {nextChapter ? (
      <a href={getUrl(`/chapter/${getChapterSlug(nextChapter)}/`)} class="nav-link" rel="next">
        <span class="nav-label">Next →</span>
        <span class="nav-title">{nextChapter.data.title}</span>
      </a>
    ) : (
      <span class="nav-disabled">
        <span class="nav-label">Next →</span>
        <span class="nav-title">End of manuscript</span>
      </span>
    )}
  </div>
</nav>

<style>
  .chapter-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
    padding-top: 2.5rem;
    margin-top: 4rem;
    border-top: 1px solid var(--border-color);
  }

  .nav-item {
    display: flex;
    flex-direction: column;
  }

  .nav-prev {
    text-align: left;
  }

  .nav-contents {
    text-align: center;
  }

  .nav-next {
    text-align: right;
  }

  .nav-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--text-primary);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    border: 1px solid transparent;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .nav-link:hover {
    background-color: var(--panel-bg);
    border-color: var(--border-color);
  }

  .nav-link:focus-visible, .contents-link:focus-visible {
    outline: 2px solid var(--accent-color);
    outline-offset: 2px;
  }

  .contents-link {
    align-items: center;
    justify-content: center;
  }

  .nav-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-color);
    margin-bottom: 0.25rem;
  }

  .nav-title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-primary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .nav-disabled {
    padding: 0.75rem 1rem;
    opacity: 0.4;
  }

  .nav-icon {
    font-size: 1.25rem;
    line-height: 1;
    margin-bottom: 0.2rem;
  }

  @media (max-width: 640px) {
    .chapter-nav {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "prev next"
        "contents contents";
    }

    .nav-prev {
      grid-area: prev;
    }

    .nav-next {
      grid-area: next;
    }

    .nav-contents {
      grid-area: contents;
      margin-top: 0.5rem;
    }
  }
</style>
