---
import { getUrl } from '../lib/chapters';
import type { BookEntry } from '../lib/books';

interface Props {
  book: BookEntry;
}

const { book } = Astro.props;
const audiobook = book.data.audiobook;
const enabled = audiobook?.enabled ?? false;
const narrator = audiobook?.narrator || '';
const chaptersUrl = audiobook?.chaptersUrl || '';
const chapters = (audiobook?.chapters || []) as Array<{ title: string; file: string }>;
const cover = book.data.cover || 'images/book_cover.jpg';
const title = book.data.title || '';
---

{enabled ? (
  <section class="audiobook-section">
    <div class="audiobook-container">
      <div class="section-label">AUDIOBOOK EDITION</div>
      <h2 class="audiobook-main-title">Narrated Audiobook</h2>

      <div class="audiobook-card">
        <div class="audiobook-cover-col">
          <img
            src={getUrl(cover)}
            alt={'Audiobook cover for ' + title}
            class="audiobook-cover"
            width="240"
            height="340"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="audiobook-info-col">
          <div class="blueprint-badge">AUDIOBOOK • {chapters.length} CHAPTERS</div>
          <h3 class="audiobook-title">{title}</h3>
          {narrator && <p class="audiobook-narrator">Narrated by {narrator}</p>}
          <p class="audiobook-description">
            The complete, full-length audio recording of the manuscript. Select a chapter below to listen,
            or pick up wherever you left off.
          </p>
        </div>
      </div>

      <button type="button" class="chapter-toggle" id="audiobook-chapter-toggle" aria-expanded="false" aria-controls="audiobook-chapter-list">
        Show chapters ({chapters.length})
      </button>

      <div class="chapter-list" id="audiobook-chapter-list">
        {chapters.map((ch, i) => (
          <div class="chapter-row">
            <div class="chapter-index">{String(i + 1).padStart(2, '0')}</div>
            <div class="chapter-body">
              <div class="chapter-title">{ch.title}</div>
              <audio controls preload="none" class="chapter-player">
                <source src={chaptersUrl + encodeURIComponent(ch.file)} type="audio/mp4" />
                <source src={chaptersUrl + encodeURIComponent(ch.file)} type="audio/mpeg" />
                Your browser does not support the audio element.
              </audio>
            </div>
          </div>
        ))}
      </div>

      <div class="audiobook-status">
        <span class="status-icon">🎙️</span>
        <span>Full audiobook now available{narrator ? ' — narrated by ' + narrator + '.' : '.'}</span>
      </div>
    </div>
  </section>
) : null}

<style>
  .audiobook-section { padding-bottom: 4rem; margin-bottom: 4rem; border-bottom: 1px solid var(--border-color); }
  .audiobook-container { max-width: 1080px; margin: 0 auto; }
  .section-label { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em; color: var(--accent-color); margin-bottom: 0.5rem; }
  .audiobook-main-title { font-size: 2.25rem; font-weight: 800; color: var(--text-primary); margin-bottom: 2rem; letter-spacing: -0.02em; }
  .audiobook-card { background-color: var(--panel-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 2rem; display: grid; grid-template-columns: 240px 1fr; gap: 2.5rem; align-items: start; box-shadow: 0 6px 20px rgba(0, 0, 0, 0.04); }
  .audiobook-cover-col { display: flex; justify-content: center; }
  .audiobook-cover { width: 100%; max-width: 240px; height: auto; border-radius: 8px; border: 1px solid var(--border-color); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12); }
  .blueprint-badge { display: inline-block; font-family: var(--font-sans); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.08em; color: var(--accent-color); background-color: rgba(2, 132, 199, 0.08); border: 1px dashed var(--accent-color); padding: 0.25rem 0.6rem; border-radius: 4px; margin-bottom: 0.75rem; }
  .audiobook-title { font-size: 1.85rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.3rem; }
  .audiobook-narrator { font-size: 0.95rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 1rem; }
  .audiobook-description { font-size: 1rem; line-height: 1.6; color: var(--text-primary); margin-bottom: 0; }
  .audiobook-description code, .audiobook-status code { font-family: var(--font-sans); background-color: rgba(2, 132, 199, 0.08); color: var(--accent-color); padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.85em; }
  .chapter-toggle { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 2rem; padding: 0.6rem 1.1rem; font-family: var(--font-sans); font-size: 0.85rem; font-weight: 700; color: var(--text-primary); background-color: var(--panel-bg); border: 1px solid var(--border-color); border-radius: 8px; cursor: pointer; transition: background-color 0.15s ease, border-color 0.15s ease; }
  .chapter-toggle:hover { background-color: var(--bg-color); border-color: var(--accent-color); }
  .chapter-toggle::after { content: '▾'; font-size: 0.8em; transition: transform 0.15s ease; }
  .chapter-toggle[aria-expanded='true']::after { transform: rotate(180deg); }
  .chapter-list { margin-top: 1rem; display: none; flex-direction: column; gap: 0.5rem; }
  .chapter-list.open { display: flex; }
  .chapter-row { display: flex; align-items: flex-start; gap: 1rem; padding: 0.75rem 1rem; background-color: var(--panel-bg); border: 1px solid var(--border-color); border-radius: 8px; }
  .chapter-index { font-family: var(--font-sans); font-size: 0.85rem; font-weight: 800; color: var(--accent-color); min-width: 2rem; padding-top: 0.4rem; text-align: right; }
  .chapter-body { flex: 1; }
  .chapter-title { font-size: 1rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.4rem; }
  .chapter-player { width: 100%; max-width: 520px; }
  .audiobook-status { display: flex; align-items: center; gap: 0.6rem; padding: 0.75rem 1rem; background-color: var(--bg-color); border: 1px solid var(--border-color); border-radius: 8px; font-size: 0.9rem; color: var(--text-secondary); margin-top: 1.5rem; }
  .status-icon { font-size: 1.1rem; }
  @media (max-width: 768px) {
    .audiobook-card { grid-template-columns: 1fr; gap: 1.75rem; padding: 1.5rem; }
    .audiobook-cover-col { max-width: 200px; margin: 0 auto; }
    .audiobook-main-title { font-size: 1.85rem; }
    .chapter-row { flex-direction: column; gap: 0.5rem; }
    .chapter-index { text-align: left; }
  }
</style>

<script>
  const toggle = document.getElementById('audiobook-chapter-toggle');
  const list = document.getElementById('audiobook-chapter-list');
  if (toggle && list) {
    toggle.addEventListener('click', () => {
      const open = list.classList.toggle('open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      const label = toggle.querySelector('.chapter-toggle-label');
      if (label) label.textContent = open ? 'Hide chapters' : 'Show chapters (' + list.children.length + ')';
    });
  }
</script>
