---
interface Props {
  slug: string;
  title: string;
  chapterNumber?: number | null;
  totalChapters?: number;
  bookSlug?: string;
}

const { slug, title, chapterNumber = null, totalChapters = 21, bookSlug = '' } = Astro.props;
---

<div
  id="reading-progress-bar"
  class="reading-progress-bar"
  aria-hidden="true"
  data-slug={slug}
  data-title={title}
  data-num={chapterNumber !== null ? chapterNumber.toString() : 'FM'}
  data-total={totalChapters.toString()}
  data-book-slug={bookSlug}
></div>

<script>
  function initReadingProgress() {
    const progressBar = document.getElementById('reading-progress-bar');
    if (!progressBar) return;

    const slug = progressBar.getAttribute('data-slug');
    const title = progressBar.getAttribute('data-title');
    const num = progressBar.getAttribute('data-num');
    const bookSlug = progressBar.getAttribute('data-book-slug') || '';
    const total = parseInt(progressBar.getAttribute('data-total') || '21', 10);
    const PREFIX = 'bookforge:' + bookSlug + ':';

    if (!slug) return;

    try {
      localStorage.setItem(PREFIX + 'current_chapter', slug);
      if (title) localStorage.setItem(PREFIX + 'current_chapter_title', title);
      if (num) localStorage.setItem(PREFIX + 'current_chapter_num', num);
      localStorage.setItem(PREFIX + 'last_read_timestamp', Date.now().toString());
    } catch (e) {}

    function markChapterComplete() {
      try {
        const raw = localStorage.getItem(PREFIX + 'completed_chapters');
        const completed = raw ? JSON.parse(raw) : [];
        if (!completed.includes(slug)) {
          completed.push(slug);
          localStorage.setItem(PREFIX + 'completed_chapters', JSON.stringify(completed));
          const overallPct = Math.round((completed.length / total) * 100);
          localStorage.setItem(PREFIX + 'overall_progress', overallPct.toString());
        }
      } catch (e) {}
    }

    try {
      const savedScroll = localStorage.getItem(PREFIX + 'scroll_' + slug);
      if (savedScroll) {
        const scrollPos = parseInt(savedScroll, 10);
        if (scrollPos > 30) {
          window.scrollTo({ top: scrollPos, behavior: 'instant' });
        }
      }
    } catch (e) {}

    let scrollTimeout;

    function updateProgress() {
      const scrollTotal = document.documentElement.scrollHeight - window.innerHeight;
      const currentScroll = window.scrollY;
      const percentage = scrollTotal > 0 ? Math.min(100, Math.max(0, (currentScroll / scrollTotal) * 100)) : 0;

      if (progressBar) {
        progressBar.style.width = percentage + '%';
      }

      try {
        localStorage.setItem(PREFIX + 'scroll_' + slug, Math.round(currentScroll).toString());
      } catch (e) {}

      if (percentage >= 90) {
        markChapterComplete();
      }
    }

    window.addEventListener('scroll', () => {
      if (scrollTimeout) cancelAnimationFrame(scrollTimeout);
      scrollTimeout = requestAnimationFrame(updateProgress);
    });

    updateProgress();

    const nextLink = document.querySelector('.nav-next a');
    if (nextLink) {
      nextLink.addEventListener('click', () => {
        markChapterComplete();
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initReadingProgress);
</script>

<style>
  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 4px;
    background-color: var(--accent-color);
    width: 0%;
    z-index: 1000;
    transition: width 0.1s ease-out;
  }
</style>
